---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import Experience from "@/components/Experience.astro";
import Projects from "@/components/Projects.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import SkillsCarousel from "@/components/SkillsCarousel.astro";
---

<Layout>
  <Hero />
  <SectionHeader
    id="habilidades"
    title="Habilidades"
    subtitle="Tecnologías y herramientas que uso a diario para diseñar, construir y optimizar productos digitales."
  >
    <SkillsCarousel />
  </SectionHeader>
  <SectionHeader
    id="proyectos"
    title="Proyectos"
    subtitle="Una selección de proyectos clave en los que he trabajado: back office bancario, banca móvil y plataformas web."
  >
    <Projects />
  </SectionHeader>
  <SectionHeader
    id="experiencia"
    title="Experiencia"
    subtitle="Mi trayectoria como desarrollador Front-End construyendo productos digitales en el sector bancario."
  >
    <Experience />
  </SectionHeader>
</Layout>
