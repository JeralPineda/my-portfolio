---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Hero from "@/components/Hero.astro";
import TechMarquee from "@/components/TechMarquee.astro";
import SectionLabel from "@/components/SectionLabel.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import Experience from "@/components/Experience.astro";
import TechStack from "@/components/TechStack.astro";
import Footer from "@/components/Footer.astro";
import { projects } from "@/data/projects";
---

<BaseLayout>
  <div class="frame">
    <Header />

    <main id="contenido">
      <Hero />
      <TechMarquee />
      <!-- <GridDivider /> -->

      <section id="proyectos" class="scroll-mt-8">
        <SectionLabel label="Proyectos" />
        {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
      </section>

      <SectionLabel label="Experiencia" />
      <Experience />
      <TechStack />
    </main>

    <Footer />
  </div>
</BaseLayout>

<script>
  import { initImageDecks } from "@/scripts/image-deck";
  import { initLazyVideos } from "@/scripts/lazy-video";
  import { initHeroSlider } from "@/scripts/hero-slider";
  import { initTheme } from "@/scripts/theme";
  import { initAccordions } from "@/scripts/accordion";
  import { initReveals } from "@/scripts/reveal";

  initImageDecks();
  initLazyVideos();
  initHeroSlider();
  initTheme();
  initAccordions();
  initReveals();
</script>
