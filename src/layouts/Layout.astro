---
import "@/styles/global.css";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import { socialLinks } from "@/data/socials";
import { Font } from "astro:assets";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Jeral Pineda | Desarrollador Front-End",
  description = "Desarrollador Front-End en Tegucigalpa, especializado en React, React Native, TypeScript y productos digitales para banca y plataformas web.",
  image = "/og-image.png",
} = Astro.props;

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site ?? Astro.url.origin,
);
const socialImageURL = new URL(image, Astro.site ?? Astro.url.origin);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://jeralpineda.dev/#person",
  name: "Jeral Cristopher Pineda Mejia",
  alternateName: "Jeral Pineda",
  url: "https://jeralpineda.dev/",
  image: "https://avatars.githubusercontent.com/u/71604462?v=4",
  jobTitle: "Desarrollador Front-End",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Tegucigalpa",
    addressCountry: "HN",
  },
  sameAs: socialLinks.map((link) => link.href),
  knowsAbout: [
    "React",
    "React Native",
    "TypeScript",
    "Astro",
    "Next.js",
    "Accesibilidad web",
    "Desarrollo de aplicaciones móviles",
  ],
};
---

<html lang="es-HN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-inter" preload />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonicalURL.href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jeral Pineda" />
    <meta property="og:locale" content="es_HN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={socialImageURL.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Jeral Pineda, desarrollador Front-End"
    />

    <title>{title}</title>

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
  </head>
  <body>
    <a href="#main" class="skip-link">Saltar al contenido</a>
    <div class="site-rail" aria-hidden="true"></div>
    <Navbar />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>

<style>
  .site-rail {
    position: fixed;
    z-index: 40;
    top: 0;
    bottom: 0;
    left: 50%;
    width: min(calc(100% - 2rem), 72rem);
    border-inline: 1px solid var(--color-line);
    pointer-events: none;
    transform: translateX(-50%);
  }

  @media (min-width: 640px) {
    .site-rail {
      width: min(calc(100% - 3rem), 72rem);
    }
  }

  @media (max-width: 1199px) {
    .site-rail {
      display: none;
    }
  }
</style>
