---
import "@/styles/global.css";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Jeral Pineda — Front-End Developer",
  description = "Jeral Pineda — Desarrollador Front-End con experiencia en diseño, desarrollo y mantenimiento de sistemas internos, aplicaciones móviles y plataformas web.",
} = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=2" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <!-- <a href="#main" class="skip-link">Saltar al contenido</a> -->
    <div class="site-rail" aria-hidden="true"></div>
    <Navbar />

    <main id="main">
      <slot />
    </main>

    <Footer />
  </body>
</html>

<style>
  .site-rail {
    position: fixed;
    z-index: 40;
    top: 0;
    bottom: 0;
    left: 50%;
    width: min(calc(100% - 2rem), 72rem);
    border-inline: 1px solid var(--color-line);
    pointer-events: none;
    transform: translateX(-50%);
  }

  @media (min-width: 640px) {
    .site-rail {
      width: min(calc(100% - 3rem), 72rem);
    }
  }

  @media (max-width: 1199px) {
    .site-rail {
      display: none;
    }
  }
</style>
