---
interface Props {
  src: string;
  poster?: string;
  aspect: string;
  alt: string;
}

const { src, poster, aspect, alt } = Astro.props;
---

<div class="flex w-full items-center justify-center bg-panel px-6 py-10 sm:py-14">
  <div
    class="relative w-full max-w-[268px] overflow-hidden rounded-[2.6rem] border-[10px] border-ink bg-ink shadow-lift"
  >
    <!-- Dynamic island -->
    <!-- <div -->
    <!--   class="absolute top-2 left-1/2 z-10 h-[18px] w-[86px] -translate-x-1/2 rounded-full bg-ink" -->
    <!--   aria-hidden="true" -->
    <!-- > -->
    <!-- </div> -->

    <!-- La relación de aspecto vive aquí, en la pantalla, y no en el bisel: así
      la caja de contenido coincide exacta con la grabación y `object-cover` no
      recorta los lados. El `translateZ(0)` fuerza a Safari a recortar la capa
      del video contra el radio; sin él las esquinas cuadradas pintan encima
      del bisel en iOS. -->
    <div
      class="relative [transform:translateZ(0)] overflow-hidden rounded-[2rem]"
      style={`aspect-ratio: ${aspect};`}
    >
      <video
        class="absolute inset-0 h-full w-full bg-black object-cover"
        data-lazy-video
        data-src={src}
        data-poster={poster}
        aria-label={alt}
        muted
        loop
        playsinline
        preload="none"
        disablepictureinpicture></video>
    </div>

    <!-- Home indicator -->
    <div
      class="absolute bottom-2 left-1/2 z-10 h-[4px] w-[100px] -translate-x-1/2 rounded-full bg-white/60"
      aria-hidden="true"
    >
    </div>
  </div>
</div>
