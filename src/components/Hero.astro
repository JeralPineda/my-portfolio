---
import HeroCollage from "@/components/HeroCollage.astro";
import ButtonLink from "@/components/ButtonLink.astro";
import HighlightMark from "@/components/HighlightMark.astro";
import { site } from "@/data/site";
---

<section
  id="top"
  class="grid items-center gap-10 border-b border-line px-6 py-16 sm:px-10 lg:min-h-[calc(100dvh-4rem)] lg:grid-cols-[1.05fr_1fr] lg:gap-14 lg:py-20"
>
  <div class="max-w-xl">
    <h1
      class="enter-up text-4xl leading-[1.18] font-bold tracking-tight text-ink sm:text-5xl lg:text-[3.25rem]"
    >
      Hola, soy Jeral Pineda Desarrollador<br class="hidden sm:inline" />
      <HighlightMark>Front-End</HighlightMark> con +3 años de experiencia.
    </h1>

    <p class="enter-up mt-7 text-[15px] leading-relaxed text-ink-muted" style="--enter-delay: 80ms">
      Especializado en React, React Native/Expo y Next.js. Experiencia desarrollando aplicaciones
      web y móviles con enfoque en seguridad, rendimiento, experiencia de usuario e integración de
      APIs.
    </p>

    <div class="enter-up mt-9 flex flex-wrap items-center gap-3" style="--enter-delay: 160ms">
      <ButtonLink href={site.cv} external hideExternalIcon>Descargar CV</ButtonLink>
      <ButtonLink href={`mailto:${site.email}`} variant="outline">Contáctame</ButtonLink>
    </div>
  </div>

  <div class="enter-up lg:pl-4" style="--enter-delay: 200ms">
    <HeroCollage />
  </div>
</section>
