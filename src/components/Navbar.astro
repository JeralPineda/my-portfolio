---
import Logo from "@/icons/Logo.astro";
import { Menu, X } from "@lucide/astro";

const links = [
  { label: "Habilidades", href: "#habilidades" },
  { label: "Proyectos", href: "#proyectos" },
  { label: "Experiencia", href: "#experiencia" },
];
---

<header
  class="site-header border-line absolute inset-x-0 top-0 z-50 border-b"
>
  <nav
    aria-label="Navegación principal"
    class="mx-auto flex max-w-6xl items-center justify-between px-6 py-6 md:px-12"
  >
    <a
      href="/"
      aria-label="Jeral Pineda — Inicio"
      class="flex size-11 items-center justify-center text-sm font-medium tracking-tight text-white"
    >
      <Logo class="h-6 w-6" aria-hidden="true" />
      <!-- Jeral Pineda -->
    </a>

    <ul class="hidden items-center gap-7 text-sm text-zinc-300 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="after:bg-accent relative flex min-h-11 items-center px-2 transition-colors after:absolute after:right-2 after:bottom-1.5 after:left-2 after:h-px after:origin-left after:scale-x-0 after:transition-transform after:duration-200 hover:text-white hover:after:scale-x-100 motion-reduce:after:transition-none"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <button
      type="button"
      class="menu-toggle flex size-11 items-center justify-center rounded-full text-zinc-300 transition-colors hover:text-white md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú"
    >
      <Menu
        class="icon-menu"
        size={20}
        stroke-width={1.75}
        aria-hidden="true"
      />
      <X
        class="icon-close hidden"
        size={20}
        stroke-width={1.75}
        aria-hidden="true"
      />
    </button>
  </nav>

  <nav
    id="mobile-menu"
    aria-label="Navegación móvil"
    class="mobile-menu hidden md:hidden"
  >
    <ul class="flex flex-col gap-1 px-6 py-4">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="mobile-link block rounded-lg px-3 py-3 text-sm text-zinc-300 transition-[color,background-color,transform] duration-200 hover:translate-x-1 motion-reduce:transition-none motion-reduce:hover:transform-none"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  @media (max-width: 1199px) {
    .site-header {
      border-color: transparent;
    }
  }

  .mobile-menu {
    background: color-mix(in srgb, var(--color-void) 90%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    animation: menu-in 0.2s ease-out;
  }

  .mobile-link:hover {
    background: color-mix(in srgb, var(--color-surface) 85%, transparent);
    color: #ffffff;
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu {
      animation: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const header = document.querySelector<HTMLElement>(".site-header");
  const iconMenu = toggle?.querySelector(".icon-menu");
  const iconClose = toggle?.querySelector(".icon-close");

  function setMenu(open: boolean) {
    menu?.classList.toggle("hidden", !open);
    iconMenu?.classList.toggle("hidden", open);
    iconClose?.classList.toggle("hidden", !open);
    toggle?.setAttribute("aria-expanded", String(open));
    toggle?.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
  }

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    setMenu(!isOpen);
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      setMenu(false);
      const target = document.querySelector<HTMLElement>(link.hash);
      requestAnimationFrame(() => {
        target
          ?.querySelector<HTMLElement>("h2")
          ?.focus({ preventScroll: true });
      });
    });
  });

  document.addEventListener("keydown", (event) => {
    if (
      event.key === "Escape" &&
      toggle?.getAttribute("aria-expanded") === "true"
    ) {
      setMenu(false);
      toggle.focus();
    }
  });

  document.addEventListener("pointerdown", (event) => {
    if (
      toggle?.getAttribute("aria-expanded") === "true" &&
      event.target instanceof Node &&
      !header?.contains(event.target)
    ) {
      setMenu(false);
    }
  });

  window
    .matchMedia("(min-width: 768px)")
    .addEventListener("change", (event) => {
      if (event.matches) setMenu(false);
    });
</script>
