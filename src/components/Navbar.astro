---
const links = [
  { label: "Upward Studio", href: "#" },
  { label: "Our Services", href: "#", chevron: true },
  { label: "Team", href: "#" },
  { label: "Blog", href: "#" },
  { label: "AI", href: "#" },
];
---

<header class="rise absolute inset-x-0 top-0 z-50">
  <nav
    aria-label="Main"
    class="mx-auto flex max-w-7xl items-center justify-between px-6 py-6"
  >
    <a
      href="/"
      class="flex items-center gap-2 text-sm font-medium tracking-tight text-white"
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M12 2c.6 4.9 4.5 8.8 9.4 9.4-4.9.6-8.8 4.5-9.4 9.4-.6-4.9-4.5-8.8-9.4-9.4C7.5 10.8 11.4 6.9 12 2Z"
          fill="currentColor"></path>
      </svg>
      upward studio<sup class="text-mist text-[9px]">®</sup>
    </a>

    <ul
      class="bg-surface/80 hidden items-center gap-7 rounded-full border border-white/10 px-8 py-3 text-[13px] text-zinc-300 backdrop-blur md:flex"
    >
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="flex items-center gap-1.5 transition-colors hover:text-white"
            >
              {link.label}
              {link.chevron && (
                <svg
                  width="10"
                  height="10"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              )}
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href="#"
      class="hover:bg-accent rounded-full bg-white px-5 py-2.5 text-[13px] font-medium text-black transition-colors"
    >
      Contact Us
    </a>
  </nav>
</header>
