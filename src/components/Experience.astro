---
import { positions } from "@/data/experience";
---

<section id="experiencia" class="scroll-mt-8" data-accordion>
  {
    positions.map((position, index) => {
      const panelId = `experiencia-panel-${index}`;
      const expanded = index === 0;

      return (
        // Las filas entran encadenadas, no a la vez: 60ms por posición basta
        // para que se lean como una lista que se despliega.
        <div class="reveal border-b border-line" style={`--reveal-delay: ${index * 60}ms`}>
          <h3>
            <button
              type="button"
              class="group flex w-full cursor-pointer items-start gap-6 px-6 py-10 text-left sm:px-10"
              aria-expanded={expanded ? "true" : "false"}
              aria-controls={panelId}
              data-accordion-trigger
            >
              <span class="flex flex-1 flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
                <span class="block">
                  <span class="block text-xl font-bold tracking-tight text-ink">
                    {position.company}
                  </span>
                  <span class="mt-1 block text-[15px] text-ink-muted">{position.role}</span>
                </span>
                <span class="shrink-0 text-[13px] text-ink-subtle sm:text-right">
                  <span class="flex items-center gap-2 sm:justify-end">
                    {position.current && (
                      <span
                        class="inline-block size-1.5 rounded-full bg-emerald-500 dark:bg-emerald-400"
                        aria-hidden="true"
                      />
                    )}
                    {position.period}
                  </span>
                  <span class="mt-0.5 block">{position.location}</span>
                </span>
              </span>

              {/* Un solo "+" que gira 45° hasta leerse como "×" cuando se abre. */}
              <span
                class="accordion-icon relative mt-1 block size-4 shrink-0 text-ink-subtle group-hover:text-ink group-aria-expanded:rotate-45"
                aria-hidden="true"
              >
                <span class="absolute top-1/2 left-0 h-px w-full -translate-y-1/2 bg-current" />
                <span class="absolute top-0 left-1/2 h-full w-px -translate-x-1/2 bg-current" />
              </span>
            </button>
          </h3>

          <div id={panelId} class="accordion-panel" data-accordion-panel inert={!expanded}>
            <div class="overflow-hidden">
              <p class="max-w-[68ch] px-6 pb-12 text-[15px] leading-relaxed text-ink-muted sm:px-10">
                {position.summary}
              </p>
            </div>
          </div>
        </div>
      );
    })
  }
</section>

<style>
  /* El alto se anima con `grid-template-rows` en vez de medirlo en JS: el
     panel es una rejilla de una fila que pasa de 0fr a 1fr. */
  .accordion-panel {
    display: grid;
    grid-template-rows: 0fr;
  }

  /* El disparador vive dentro del <h3>, así que el estado se lee con :has()
     en la cabecera hermana del panel. */
  h3:has([aria-expanded="true"]) + .accordion-panel {
    grid-template-rows: 1fr;
  }

  .accordion-panel > * {
    min-height: 0;
  }

  .accordion-panel > * > * {
    opacity: 0;
    transform: translateY(-4px);
  }

  h3:has([aria-expanded="true"]) + .accordion-panel > * > * {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .accordion-panel {
      transition: grid-template-rows 320ms cubic-bezier(0.32, 0.72, 0, 1);
    }

    .accordion-panel > * > * {
      transition:
        opacity 220ms ease,
        transform 320ms cubic-bezier(0.32, 0.72, 0, 1);
    }

    /* Tailwind v4 gira con la propiedad `rotate`, no con `transform`. */
    .accordion-icon {
      transition:
        rotate 320ms cubic-bezier(0.32, 0.72, 0, 1),
        color 220ms ease;
    }
  }
</style>
