---
import { skillGroups } from "@/data/experience";

/**
 * Infinite auto-scrolling band of core technologies, sourced from the "Core"
 * group in the skills data so the band and the stack section never drift apart.
 *
 * Each group repeats the list until it comfortably overflows the widest
 * container — otherwise the -50% translate would expose a gap mid-loop with a
 * short list. The group is then rendered twice so the seam is invisible and the
 * loop needs no JavaScript.
 */
const core = skillGroups.find((group) => group.label === "Core")?.items ?? [];

const MIN_ITEMS_PER_GROUP = 12;
const repeats = Math.max(2, Math.ceil(MIN_ITEMS_PER_GROUP / Math.max(core.length, 1)));
const items = Array.from({ length: repeats }, () => core).flat();
---

<section class="marquee border-b border-line bg-band" aria-label="Tecnologías principales">
  <div class="marquee__track">
    {
      [0, 1].map((copy) => (
        <ul class="marquee__group" aria-hidden={copy === 1 ? "true" : undefined}>
          {items.map((item) => (
            <li class="marquee__item">
              <span>{item}</span>
              <svg class="marquee__sparkle" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 0c.9 6 5.1 10.2 11.1 11.1v1.8C17.1 13.8 12.9 18 12 24c-.9-6-5.1-10.2-11.1-11.1v-1.8C6.9 10.2 11.1 6 12 0z" />
              </svg>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</section>

<style>
  .marquee {
    overflow: hidden;
    padding-block: 1.15rem;
    /* Fade the band into the page edges instead of cutting words mid-glyph. */
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 6rem,
      #000 calc(100% - 6rem),
      transparent
    );
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee-scroll 34s linear infinite;
  }

  .marquee__group {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .marquee__item {
    display: flex;
    align-items: center;
    gap: 2.25rem;
    padding-inline-end: 2.25rem;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    color: var(--color-band-ink);
    white-space: nowrap;
  }

  .marquee__sparkle {
    width: 0.85rem;
    height: 0.85rem;
    flex-shrink: 0;
    fill: var(--color-band-accent);
  }

  @keyframes marquee-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  /* A band that never stops moving is hostile to motion-sensitive users; hold
     it still and let it scroll horizontally instead. */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      overflow-x: auto;
      mask-image: none;
    }

    .marquee__track {
      animation: none;
    }

    .marquee__group[aria-hidden="true"] {
      display: none;
    }
  }
</style>
