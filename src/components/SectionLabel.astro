---
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<div class="flex flex-col items-center gap-2 border-b border-line px-6 py-20">
  <span class="block h-0.5 w-6 bg-ink" aria-hidden="true"></span>
  <h2 class="text-[20px] font-bold tracking-[0.18em] text-ink uppercase">{label}</h2>
</div>
