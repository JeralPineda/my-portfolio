---
import { Pause, Play } from "@lucide/astro";
import SkillLogo from "@/components/SkillLogo.astro";
import { skills } from "@/data/skills";

const rows = [0, 1, 2].map((row) =>
  skills.filter((_, index) => index % 3 === row),
);
const directions = ["left", "right", "left"];
const durations = [78, 88, 82];
---

<div class="skills-carousel mx-auto mt-16 max-w-5xl space-y-5 pb-16 md:pb-24">
  <div class="carousel-controls flex justify-end px-6">
    <button
      type="button"
      data-carousel-toggle
      aria-pressed="false"
      class="border-line flex min-h-11 items-center gap-2 rounded-full border px-4 text-sm text-zinc-300 transition-colors hover:border-white/20 hover:text-white"
    >
      <Pause data-pause-icon size={16} stroke-width={1.75} aria-hidden="true" />
      <Play
        data-play-icon
        class="hidden"
        size={16}
        stroke-width={1.75}
        aria-hidden="true"
      />
      <span data-carousel-label>Pausar movimiento</span>
    </button>
  </div>

  {
    rows.map((row, rowIndex) => (
      <div class:list={["marquee", rowIndex === 1 && "marquee--middle"]}>
        <div
          class:list={[
            "marquee-track",
            directions[rowIndex] === "right" && "marquee-track--right",
          ]}
          style={`--marquee-duration: ${durations[rowIndex]}s`}
        >
          {[false, true].map((isDuplicate) => (
            <ul
              class="marquee-group"
              aria-hidden={isDuplicate ? "true" : undefined}
            >
              {row.map((skill) => (
                <li class="carousel-card">
                  <SkillLogo skill={skill} size={20} />
                  <span>{skill.name}</span>
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    ))
  }
</div>

<style>
  .marquee {
    width: 94%;
    overflow: hidden;
    margin-inline: auto;
    mask-image: linear-gradient(
      to right,
      transparent,
      black 10%,
      black 90%,
      transparent
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 10%,
      black 90%,
      transparent
    );
  }

  .marquee--middle {
    width: 100%;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee-left var(--marquee-duration) linear infinite;
    backface-visibility: hidden;
    will-change: transform;
  }

  .marquee-track--right {
    animation-name: marquee-right;
  }

  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  .skills-carousel.is-paused .marquee-track {
    animation-play-state: paused;
  }

  .marquee-group {
    display: flex;
    flex-shrink: 0;
    gap: 2rem;
    padding-right: 2rem;
  }

  .carousel-card {
    display: flex;
    width: 10rem;
    min-height: 5rem;
    flex-shrink: 0;
    align-items: center;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem;
    border: 1px solid var(--color-line);
    border-radius: 10px;
    background: color-mix(in srgb, var(--color-surface) 82%, transparent);
    color: #a1a1aa;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.2;
    padding: 0.75rem;
    text-align: center;
    transition:
      border-color 200ms ease,
      color 200ms ease;
  }

  .carousel-card:hover {
    border-color: var(--color-line-strong);
    color: #ffffff;
  }

  @keyframes marquee-left {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @keyframes marquee-right {
    from {
      transform: translate3d(-50%, 0, 0);
    }

    to {
      transform: translate3d(0, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-controls {
      display: none;
    }

    .marquee {
      width: 100%;
      overflow: visible;
      mask-image: none;
      -webkit-mask-image: none;
    }

    .marquee-track {
      display: block;
      width: 100%;
      animation: none;
      transform: none;
    }

    .marquee-group {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
      padding: 0 1.5rem;
    }

    .carousel-card {
      width: auto;
      min-width: 0;
    }

    .marquee-group[aria-hidden="true"] {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) and (min-width: 640px) {
    .marquee-group {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) and (min-width: 1024px) {
    .marquee-group {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>

<script>
  const carousel = document.querySelector<HTMLElement>(".skills-carousel");
  const carouselToggle = carousel?.querySelector<HTMLButtonElement>(
    "[data-carousel-toggle]",
  );
  const carouselLabel = carousel?.querySelector<HTMLElement>(
    "[data-carousel-label]",
  );
  const pauseIcon = carousel?.querySelector<HTMLElement>("[data-pause-icon]");
  const playIcon = carousel?.querySelector<HTMLElement>("[data-play-icon]");

  carouselToggle?.addEventListener("click", () => {
    const paused = carousel?.classList.toggle("is-paused") ?? false;
    carouselToggle.setAttribute("aria-pressed", String(paused));
    if (carouselLabel) {
      carouselLabel.textContent = paused
        ? "Reanudar movimiento"
        : "Pausar movimiento";
    }
    pauseIcon?.classList.toggle("hidden", paused);
    playIcon?.classList.toggle("hidden", !paused);
  });
</script>
