---
import { ArrowUpRight, LockKeyhole } from "@lucide/astro";
import { projects } from "@/data/projects";
---

<div class="mx-auto mt-16 max-w-6xl space-y-8 px-6 pb-24">
  {
    projects.map((project) => (
      <article
        class:list={[
          "project-card",
          project.theme === "blue"
            ? "project-card--blue"
            : "project-card--accent",
        ]}
      >
        <div class="project-copy">
          <p class="text-accent text-[11px] font-semibold tracking-[0.18em] uppercase">
            {project.category}
          </p>
          <h3 class="mt-4 text-3xl leading-tight font-semibold tracking-tight text-white sm:text-4xl">
            {project.title}
          </h3>
          <p class="mt-7 text-sm font-medium text-white">{project.role}</p>
          <p class="text-mist mt-3 max-w-xl text-sm leading-relaxed">
            {project.description}
          </p>

          <ul class="mt-6 flex flex-wrap gap-2" aria-label="Tecnologías">
            {project.technologies.map((technology) => (
              <li class="rounded-full border border-white/10 bg-black/15 px-3 py-1.5 text-[11px] text-zinc-300">
                {technology}
              </li>
            ))}
          </ul>

          <div class="mt-7 flex flex-wrap items-center gap-3">
            {project.links?.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="project-link inline-flex items-center gap-2 rounded-full border border-white/12 bg-black/20 px-4 py-2 text-xs font-medium text-white"
                aria-label={`${link.label} de ${project.title} (abre en una pestaña nueva)`}
              >
                {link.label}
                <ArrowUpRight
                  size={14}
                  stroke-width={1.75}
                  aria-hidden="true"
                />
              </a>
            ))}

            {project.status === "internal" && (
              <span class="inline-flex items-center gap-2 text-xs text-zinc-400">
                <LockKeyhole size={14} stroke-width={1.75} aria-hidden="true" />
                Proyecto interno
              </span>
            )}
          </div>
        </div>

        <figure class="project-visual">
          <img
            src={project.image}
            alt={project.imageAlt}
            width="720"
            height="480"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </article>
    ))
  }
</div>

<style>
  .project-card {
    position: relative;
    display: grid;
    min-height: 25rem;
    overflow: hidden;
    grid-template-columns: minmax(0, 0.9fr) minmax(20rem, 1.1fr);
    align-items: center;
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 2rem;
    transition:
      border-color 300ms ease,
      box-shadow 300ms ease;
  }

  .project-card--blue {
    background:
      radial-gradient(
        circle 18rem at 82% 38%,
        color-mix(in srgb, var(--color-glow) 16%, transparent) 0%,
        color-mix(in srgb, var(--color-glow) 7%, transparent) 42%,
        transparent 100%
      ),
      var(--color-surface);
  }

  .project-card--accent {
    background:
      radial-gradient(
        circle 18rem at 82% 38%,
        color-mix(in srgb, var(--color-accent) 11%, transparent) 0%,
        color-mix(in srgb, var(--color-accent) 5%, transparent) 42%,
        transparent 100%
      ),
      var(--color-surface);
  }

  .project-copy {
    position: relative;
    z-index: 1;
    padding: 3rem;
  }

  .project-visual {
    display: flex;
    min-width: 0;
    align-self: stretch;
    align-items: center;
    justify-content: center;
    padding: 1.5rem 1.5rem 1.5rem 0;
  }

  .project-visual img {
    width: 100%;
    max-width: 36rem;
    height: auto;
    filter: saturate(0.92);
    transition:
      filter 300ms ease,
      transform 300ms ease;
  }

  .project-link {
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      color 200ms ease;
  }

  .project-link:hover {
    border-color: color-mix(in srgb, var(--color-accent) 42%, transparent);
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    color: var(--color-accent);
  }

  .project-card:hover {
    border-color: rgb(255 255 255 / 0.16);
    box-shadow: 0 28px 80px -52px rgb(30 107 255 / 0.7);
  }

  .project-card:hover .project-visual img {
    filter: saturate(1.08);
    transform: translateY(-4px) scale(1.012);
  }

  @media (max-width: 767px) {
    .project-card {
      min-height: auto;
      grid-template-columns: 1fr;
      border-radius: 1.5rem;
    }

    .project-copy {
      padding: 2rem 1.5rem 1rem;
    }

    .project-visual {
      padding: 0 1rem 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-visual img,
    .project-link {
      transition: none;
    }

    .project-card:hover .project-visual img {
      transform: none;
    }
  }
</style>
