---
import {
  Database,
  MessageSquare,
  Palette,
  PawPrint,
  Wind,
  Zap,
} from "@lucide/astro";
import type { AstroComponent } from "@lucide/astro";
import type { Skill, SkillFallbackIcon } from "@/data/skills";

interface Props {
  skill: Skill;
  size?: number;
}

const { skill, size = 24 } = Astro.props;

const fallbackIcons: Record<SkillFallbackIcon, AstroComponent> = {
  database: Database,
  "message-square": MessageSquare,
  palette: Palette,
  "paw-print": PawPrint,
  wind: Wind,
  zap: Zap,
};

const Icon = skill.icon ? fallbackIcons[skill.icon] : undefined;
---

{
  skill.slug ? (
    <span
      aria-hidden="true"
      class="skill-logo"
      style={`--icon-size: ${size}px; --icon-url: url(/icons/skills/${skill.slug}.svg)`}
    />
  ) : (
    Icon && <Icon size={size} stroke-width={1.75} aria-hidden="true" />
  )
}

<style>
  .skill-logo {
    width: var(--icon-size);
    height: var(--icon-size);
    flex-shrink: 0;
    background-color: currentColor;
    mask-image: var(--icon-url);
    mask-position: center;
    mask-repeat: no-repeat;
    mask-size: contain;
  }
</style>
