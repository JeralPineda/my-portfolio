---
interface Props {
  id: string;
  title: string;
  subtitle: string;
}

const { id, title, subtitle } = Astro.props;
const hasContent = Astro.slots.has("default");
---

<section id={id} aria-labelledby={`${id}-title`} class="relative scroll-mt-10">
  <div
    aria-hidden="true"
    class="border-line mx-auto hidden max-w-6xl border-t min-[1200px]:block"
  >
  </div>
  <div class="mx-auto max-w-3xl px-6 pt-24 text-center md:pt-32">
    <h2
      id={`${id}-title`}
      tabindex="-1"
      class="text-3xl leading-tight font-medium tracking-tight text-balance text-white sm:text-4xl md:text-5xl"
    >
      {title}
    </h2>
    <p class="text-mist mx-auto mt-6 max-w-lg text-sm leading-relaxed">
      {subtitle}
    </p>
  </div>

  <slot />

  {!hasContent && <div aria-hidden="true" class="min-h-[45vh]" />}
</section>
