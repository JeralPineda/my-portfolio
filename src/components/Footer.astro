---
import Logo from "@/components/Logo.astro";
import BackToTop from "@/components/BackToTop.astro";
import ThemeSwitch from "@/components/ThemeSwitch.astro";
import { site } from "@/data/site";
import { projects } from "@/data/projects";

const year = new Date().getFullYear();

const contact = [
  { label: "Email", href: `mailto:${site.email}`, external: false },
  { label: "GitHub", href: site.github, external: true },
  { label: "CV", href: site.cv, external: true },
];
---

<footer class="relative border-t border-line bg-canvas">
  <div class="frame-edge mx-auto max-w-[1200px] px-6 py-14 sm:px-10">
    <BackToTop />

    <div class="flex flex-col gap-12 lg:flex-row lg:justify-between lg:gap-8">
      <div class="text-ink">
        <Logo class="h-7 w-7" fill="var(--color-canvas)" />
      </div>

      <div class="grid flex-1 grid-cols-2 gap-8 sm:grid-cols-3 lg:max-w-2xl">
        <nav aria-labelledby="footer-projects">
          <h2
            id="footer-projects"
            class="text-[11px] font-medium tracking-[0.18em] text-ink-subtle uppercase"
          >
            Proyectos
          </h2>
          <ul class="mt-4 space-y-2.5">
            {
              projects.map((project) => (
                <li>
                  <a
                    href={`#${project.slug}`}
                    class="text-[13px] text-ink-muted underline-offset-4 transition-colors hover:text-ink hover:underline"
                  >
                    {project.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <nav aria-labelledby="footer-contact">
          <h2
            id="footer-contact"
            class="text-[11px] font-medium tracking-[0.18em] text-ink-subtle uppercase"
          >
            Contacto
          </h2>
          <ul class="mt-4 space-y-2.5">
            {
              contact.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="group inline-flex items-center gap-1 text-[13px] text-ink-muted underline-offset-4 transition-colors hover:text-ink hover:underline"
                    {...(item.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                  >
                    {item.label}
                    {item.external && (
                      <>
                        <svg
                          class="size-3 transition-transform group-hover:translate-x-px group-hover:-translate-y-px"
                          viewBox="0 0 14 14"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="M4 10 10 4M10 4H5M10 4v5" />
                        </svg>
                        <span class="sr-only">(abre en una pestaña nueva)</span>
                      </>
                    )}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="col-span-2 sm:col-span-1">
          <ThemeSwitch class="mb-6" />
          <p class="text-[13px] text-ink-subtle">
            © {year}
            {site.shortName}.
          </p>
          <p class="mt-3 text-[13px] text-ink-subtle">Hecho con Astro y Tailwind CSS.</p>
        </div>
      </div>
    </div>
  </div>
</footer>
