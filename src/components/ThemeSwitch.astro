---
/**
 * Selector de tema: claro (por defecto) u oscuro.
 *
 * El estado visual (chip deslizante e icono activo) sale de CSS a partir de
 * `data-theme` en <html>, que el script del <head> ya escribió — así el chip
 * aparece en su sitio en el primer frame, sin esperar a JavaScript.
 * `theme.ts` solo añade la parte que CSS no puede: `aria-checked`, el
 * tabindex rodante y la escritura en localStorage.
 */
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

const options = [
  { value: "light", label: "Tema claro" },
  { value: "dark", label: "Tema oscuro" },
] as const;

const iconClass = "size-[15px] shrink-0";
---

<div
  class={`theme-switch relative inline-flex items-center rounded-full border border-line bg-pill p-[3px] ${className}`}
  role="radiogroup"
  aria-label="Tema"
  data-theme-switch
>
  <span class="theme-switch-thumb" aria-hidden="true"></span>

  {
    options.map((option, index) => (
      <button
        type="button"
        role="radio"
        aria-checked="false"
        tabindex={index === 0 ? 0 : -1}
        data-theme-choice={option.value}
        class="theme-switch-option relative grid size-7 place-items-center rounded-full transition-colors"
      >
        {option.value === "light" && (
          <svg
            class={iconClass}
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4.2" />
            <path d="M12 1.8v2.4M12 19.8v2.4M4.8 4.8l1.7 1.7M17.5 17.5l1.7 1.7M1.8 12h2.4M19.8 12h2.4M4.8 19.2l1.7-1.7M17.5 6.5l1.7-1.7" />
          </svg>
        )}
        {option.value === "dark" && (
          <svg
            class={iconClass}
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M20.5 14.3A8.6 8.6 0 0 1 9.7 3.5a8.6 8.6 0 1 0 10.8 10.8z" />
          </svg>
        )}
        <span class="sr-only">{option.label}</span>
      </button>
    ))
  }
</div>
