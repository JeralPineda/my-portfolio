---
import SkillLogo from "@/components/SkillLogo.astro";
import { skills } from "@/data/skills";

const cardSizes = ["regular", "compact", "tall", "regular", "compact"];
---

<ul class="skills-masonry mx-auto mt-16 max-w-6xl px-6 pb-20">
  {
    skills.map((skill, index) => (
      <li class="masonry-card" data-size={cardSizes[index % cardSizes.length]}>
        <SkillLogo
          skill={skill}
          size={cardSizes[index % cardSizes.length] === "tall" ? 28 : 24}
        />
        <span>{skill.name}</span>
      </li>
    ))
  }
</ul>

<style>
  .skills-masonry {
    columns: 2;
    column-gap: 1rem;
  }

  .masonry-card {
    display: flex;
    width: 100%;
    break-inside: avoid;
    align-items: center;
    flex-direction: column;
    justify-content: center;
    gap: 0.65rem;
    margin-bottom: 1rem;
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 1.25rem;
    background: color-mix(in srgb, var(--color-surface) 82%, transparent);
    color: #a1a1aa;
    font-size: 0.875rem;
    font-weight: 500;
    opacity: 0.68;
    padding: 1rem;
    text-align: center;
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      color 200ms ease,
      opacity 200ms ease;
  }

  .masonry-card[data-size="compact"] {
    min-height: 5.5rem;
  }

  .masonry-card[data-size="regular"] {
    min-height: 7rem;
  }

  .masonry-card[data-size="tall"] {
    min-height: 8.5rem;
  }

  .masonry-card:hover {
    border-color: color-mix(in srgb, var(--color-accent) 36%, transparent);
    background: color-mix(
      in srgb,
      var(--color-surface) 92%,
      var(--color-accent) 8%
    );
    color: #ffffff;
    opacity: 1;
  }

  @media (min-width: 640px) {
    .skills-masonry {
      columns: 3;
    }
  }

  @media (min-width: 768px) {
    .skills-masonry {
      columns: 4;
    }
  }

  @media (min-width: 1024px) {
    .skills-masonry {
      columns: 5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .masonry-card {
      transition: none;
    }
  }
</style>
