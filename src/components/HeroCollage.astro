---
import { Image } from "astro:assets";
import card1 from "@/assets/hero/card-1.jpg";
import card2 from "@/assets/hero/card-2.jpg";
import card3 from "@/assets/hero/card-3.jpg";

/**
 * Rotated photo collage. Cards overlap on a fixed-height stage on desktop and
 * become a one-photo-at-a-time slider on small screens, where an overlapping
 * stack would only show slivers of the cards behind.
 */
const cards = [
  {
    image: card1,
    alt: "Escritorio con código en pantalla",
    caption: "mi setup",
    tilt: -4,
    stage: "top-0 left-2 w-[62%] rotate-[-6deg] z-20",
    captionPos: "-top-6 left-4",
  },
  {
    image: card2,
    alt: "Persona de espaldas frente al mar, en una playa de arena clara",
    caption: "fuera del código",
    tilt: 3,
    stage: "top-[22%] right-0 w-[46%] rotate-[3deg] z-30",
    captionPos: "-bottom-7 right-3",
  },
  {
    image: card3,
    alt: "Mano sosteniendo un teléfono con la pantalla de inicio llena de aplicaciones",
    caption: "React Native",
    tilt: -2,
    stage: "bottom-0 left-[14%] w-[54%] rotate-[-2deg] z-10",
    captionPos: "-bottom-7 left-6",
  },
];
---

<!-- Mobile: one photo per screen, snapped. -->
<div class="lg:hidden" data-hero-slider>
  <div
    class="flex snap-x snap-mandatory [scrollbar-width:none] overflow-x-auto overscroll-x-contain [&::-webkit-scrollbar]:hidden"
    data-hero-track
  >
    {
      cards.map((card, i) => (
        <figure
          class="flex w-full shrink-0 snap-center flex-col items-center px-6 py-4"
          data-hero-slide
        >
          {/* Recortado a la caja real (280x208) en vez de dejar que
              object-cover descarte píxeles ya descargados. */}
          <Image
            src={card.image}
            alt={card.alt}
            width={280}
            height={208}
            fit="cover"
            densities={[1, 2]}
            loading={i === 0 ? "eager" : "lazy"}
            fetchpriority={i === 0 ? "high" : undefined}
            class="h-52 w-full max-w-[280px] rounded-xl border-4 border-frame object-cover shadow-lift"
            style={`rotate: ${card.tilt}deg;`}
          />
          <figcaption class="mt-5 font-hand text-xl text-ink-muted">{card.caption}</figcaption>
        </figure>
      ))
    }
  </div>

  <div class="mt-3 flex justify-center" role="tablist" aria-label="Fotos del collage">
    {
      cards.map((card, i) => (
        <button
          type="button"
          role="tab"
          data-hero-dot
          aria-selected={i === 0 ? "true" : "false"}
          aria-label={`Ver foto: ${card.caption}`}
          class="group flex size-6 items-center justify-center"
        >
          <span class="h-2 w-2 rounded-full bg-line-strong transition-all duration-300 group-aria-selected:w-4 group-aria-selected:bg-accent" />
        </button>
      ))
    }
  </div>
</div>

<!-- Desktop: overlapping rotated stack. -->
<div class="relative hidden h-[380px] w-full lg:block xl:h-[420px]" aria-hidden="false">
  {
    cards.map((card) => (
      <figure
        class={`group absolute ${card.stage} transition-[transform,z-index] duration-300 ease-out hover:z-40 hover:scale-[1.03] hover:rotate-0`}
      >
        <Image
          src={card.image}
          alt={card.alt}
          widths={[400, 600, 800]}
          sizes="(min-width: 1280px) 340px, 280px"
          class="w-full rounded-xl border-[6px] border-frame object-cover shadow-lift"
        />
        <figcaption
          class={`absolute ${card.captionPos} font-hand text-xl whitespace-nowrap text-ink-muted transition-opacity group-hover:opacity-100`}
        >
          {card.caption}
        </figcaption>
      </figure>
    ))
  }
</div>
