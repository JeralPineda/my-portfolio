---
/**
 * Highlighter swipe behind a word. Both children are positioned and the text
 * comes second in DOM order, so it paints on top without a negative z-index —
 * which would otherwise drop the stroke behind the page background.
 *
 * The band starts around the middle of the cap height and overshoots the
 * baseline, the way a real marker does when you swipe across a word.
 */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<span class={`relative inline-block ${className}`}>
  <svg
    class="pointer-events-none absolute inset-x-[-0.1em] bottom-[-0.12em] h-[0.72em] w-[calc(100%+0.2em)] mix-blend-multiply"
    viewBox="0 0 200 40"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <!-- Body of the stroke: near-rectangular, edges slightly off-parallel. -->
    <path
      d="M1.6 7.4C62 5.2 138 4.1 197.4 2.8L198.4 32.2C139 34.1 63 35.6 2.6 37.2Z"
      fill="var(--color-marker)"
      fill-opacity="0.55"></path>
    <!-- Ink pooling along the bottom edge, where the felt tip drags. -->
    <path
      d="M2.2 27.6C62 26.2 138 25.1 198.1 23.8L198.4 32.2C139 34.1 63 35.6 2.6 37.2Z"
      fill="var(--color-marker)"
      fill-opacity="0.3"></path>
  </svg>
  <span class="relative"><slot /></span>
</span>
