---
import SkillLogo from "@/components/SkillLogo.astro";
import { skills } from "@/data/skills";
---

<ul
  data-skills-grid
  class="mx-auto mt-16 grid max-w-6xl grid-cols-2 gap-4 px-6 pb-20 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5"
>
  {
    skills.map((skill) => {
      return (
        <li
          data-skill-card
          class="skill-card group bg-surface/70 relative isolate flex min-h-24 items-center justify-center overflow-hidden rounded-lg border border-white/10 px-4 py-5"
        >
          <span class="relative z-10 flex items-center justify-center gap-3 text-zinc-400 opacity-70 transition-all duration-300 group-hover:text-white group-hover:opacity-100">
            <SkillLogo skill={skill} />
            <span class="text-sm leading-tight font-bold">{skill.name}</span>
          </span>
        </li>
      );
    })
  }
</ul>

<style>
  .skill-card {
    --mouse-x: 50%;
    --mouse-y: 50%;
    transition:
      border-color 300ms ease,
      box-shadow 300ms ease,
      transform 300ms ease;
  }

  .skill-card::before {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      160px circle at var(--mouse-x) var(--mouse-y),
      color-mix(in srgb, var(--color-accent) 22%, transparent),
      transparent 70%
    );
    content: "";
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms ease;
  }

  .skill-card:hover {
    border-color: color-mix(in srgb, var(--color-accent) 38%, transparent);
    box-shadow: 0 14px 36px -24px
      color-mix(in srgb, var(--color-accent) 45%, transparent);
    transform: translateY(-2px);
  }

  .skill-card:hover::before {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .skill-card {
      transition: none;
    }

    .skill-card::before {
      display: none;
    }

    .skill-card:hover {
      transform: none;
    }
  }
</style>

<script>
  const skillsGrid = document.querySelector<HTMLElement>("[data-skills-grid]");

  skillsGrid?.addEventListener("pointermove", (event) => {
    if (!(event.target instanceof Element)) return;

    const card = event.target.closest<HTMLElement>("[data-skill-card]");
    if (!card) return;

    const bounds = card.getBoundingClientRect();
    card.style.setProperty("--mouse-x", `${event.clientX - bounds.left}px`);
    card.style.setProperty("--mouse-y", `${event.clientY - bounds.top}px`);
  });
</script>
